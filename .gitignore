# ==================================
# 1. 默认忽略根目录下的所有内容
/*

# ==================================
# 2. 依次“放行”（取消忽略）必要的文件
!/README.md
!/README.zh-CN.md
!/AGENTS.md
!/build.py
!/requirements.txt
!/.gitattributes
!/.github/
!/.github/workflows/
!/.github/workflows/build-macos.yml
!/start.bat
!/start_build.bat
!/start.command
!/start_build.command
!/scripts/
/scripts/*
!/scripts/launch_windows.bat
!/scripts/launch_macos.sh
!/upx.exe
!/LICENSE

# ==================================
# 3. “放行”必要的文件夹及其内部内容
!/assets/
!/src/
!/.codex/
!/.codex/skills/
!/.codex/skills/renpylens-release/
!/.codex/skills/renpylens-release/SKILL.md
!/.codex/skills/renpylens-release/references/
!/.codex/skills/renpylens-release/references/github-rest.md

# ==================================
# 4. 在已放行的规则中，做特定的额外排除
/assets/icon-raw.png
/.codex/artifacts/

# Tests are kept locally and are not synchronized with the repository.
tests/

# Semantic Kernel fixtures and compact regression manifests are reviewable.
!/tests/
/tests/*
!/tests/semantics/
!/tests/semantics/**
# Runtime acceptance artifacts stay local.
/tests/semantics/artifacts/
# Ren'Py fixture runtime output stays local.
/tests/semantics/fixtures/**/game/cache/
/tests/semantics/fixtures/**/game/saves/
/tests/semantics/fixtures/**/*.rpyc
/tests/semantics/fixtures/**/log.txt

# 针对源码文件夹中的编译缓存、运行时文件做基本排除
/src/__pycache__/
*.pyc
*.pyo

# Standalone story-graph tools stay local until they are ready for release.
/graph/
